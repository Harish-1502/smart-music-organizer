# Host music folder to mount into Docker.
# Inside the app, always scan /music.
MUSIC_PATH=./music

# Optional AcoustID key for deep scan fingerprint lookups.
# Leave blank if you do not use deep scan.
ACOUSTID_API_KEY=

# Backend network binding.
# Defaults are local desktop only: http://127.0.0.1:8000
# LAN/mobile mode exposes the API on your network. Use only with API_AUTH_TOKEN
# on a trusted network, and do not expose the app to the internet.
APP_LAN_MODE=false
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Required when APP_LAN_MODE=true. Use a long random value.
# API_AUTH_TOKEN=change-me-to-a-long-random-token

# Maximum uploaded artwork size in bytes. Default is 5 MB.
UPLOAD_MAX_BYTES=5242880

# Backward-compatibility raw artwork path route (/library/art?path=...).
# Keep disabled unless you specifically need legacy path-based artwork access.
ENABLE_LEGACY_ART_PATH_ROUTE=false
